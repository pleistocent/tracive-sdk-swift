        },
        {
          "mimeType": "image/heif",
          "head": "00000018667479706d696631",
          "sizeBytes": 600
        }
      ],
      "expect": {
        "package": {
          "v": 1,
          "query": "BANK_IDN_BCA_1234567890",
          "attachments": [
            {
              "name": "attachment-1.jpg",
              "mimeType": "image/jpeg"
