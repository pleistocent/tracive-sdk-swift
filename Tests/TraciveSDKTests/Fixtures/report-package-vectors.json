{
  "version": 1,
  "about": "Conformance vectors for the Tracive report package (v1), the file a partner SDK hands to the Tracive app from openReportForm. Vendored byte-identically into all four SDK repos; edit the canonical copy and re-copy, never one repo alone.",
  "bytes": "Each attachment's bytes are generated: byte i is head[i] (hex) while i < len(head), else (i % 251). sizeBytes counts the whole attachment, head included.",
  "checking": "For an 'expect.package' case, build the package, parse it as JSON and assert: v, query, incidentDate (absent when the case has none), and each attachment's name and mimeType in order; each 'data' is standard base64 with padding and no line breaks and decodes to exactly the generated bytes. Key order and JSON escaping are not part of the contract. For an 'expect.error' case, assert the SDK's typed error for that code, plus index or max when given, and that nothing was opened.",
  "validationOrder": [
    "INCIDENT_DATE_IN_FUTURE",
    "TOO_MANY_ATTACHMENTS",
    "per attachment in order: UNSUPPORTED_TYPE, CONTENT_MISMATCH, PDF_TOO_LARGE",
    "PACKAGE_TOO_LARGE"
  ],
  "limits": {
    "pdfMaxBytesExclusive": 1048576,
    "maxAttachments": 5,
    "maxAttachmentsPhone": 10,
    "packageMaxBytes": 20971520
  },
  "cases": [
    {
      "name": "bank_pdf_and_png",
      "query": "BANK_IDN_BCA_1234567890",
      "incidentDate": "2026-11-03",
      "attachments": [
        {
          "mimeType": "application/pdf",
          "head": "255044462d312e37",
          "sizeBytes": 2048
        },
        {
          "mimeType": "image/png",
          "head": "89504e470d0a1a0a",
          "sizeBytes": 4096
        }
      ],
      "expect": {
        "package": {
          "v": 1,
          "query": "BANK_IDN_BCA_1234567890",
          "incidentDate": "2026-11-03",
          "attachments": [
            {
              "name": "attachment-1.pdf",
              "mimeType": "application/pdf"
            },
            {
              "name": "attachment-2.png",
              "mimeType": "image/png"
            }
          ]
        }
      }
    },
    {
      "name": "phone_no_date_no_attachments",
      "query": "PHONE_+6281234567890",
      "attachments": [],
      "expect": {
        "package": {
          "v": 1,
          "query": "PHONE_+6281234567890",
          "attachments": []
        }
      }
    },
