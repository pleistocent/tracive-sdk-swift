      "expected": "+6285718609079",
      "note": "Indonesian local style: the trunk prefix 0 is dropped"
    },
    {
      "country": "+62",
      "input": "0857 1860 9079",
      "expected": "+6285718609079",
      "note": "dial code with +, identical result to the alpha-3 form"
    },
    {
      "country": "62",
      "input": "085718609079",
      "expected": "+6285718609079",
      "note": "dial code without +, identical result"
    },
    {
      "country": "idn",
      "input": "0857 1860 9079",
      "expected": "+6285718609079",
      "note": "alpha-3 is case-insensitive"
    },
    {
      "country": "IDN",
      "input": "+62 857 1860 9079",
      "expected": "+6285718609079",
      "note": "the caller already passed E.164; the country code is not doubled"
    },
    {
      "country": "IDN",
      "input": "0062857 1860 9079",
      "expected": "+6285718609079",
      "note": "the 00 international prefix is dropped"
    },
    {
      "country": "IDN",
      "input": "8571860907",
      "expected": "+628571860907",
      "note": "no trunk prefix at all"
    },
    {
      "country": "USA",
      "input": "(555) 123-4567",
      "expected": "+15551234567",
      "note": "NANP without a trunk prefix"
    },
    {
      "country": "USA",
      "input": "1 555 123 4567",
      "expected": "+15551234567",
      "note": "NANP with trunk prefix 1, 11 digits"
    },
    {
      "country": "CAN",
      "input": "1 604 555 0199",
      "expected": "+16045550199",
      "note": "same dial code as the USA, same result"
    },
    {
      "country": "ITA",
      "input": "06 1234 5678",
      "expected": "+390612345678",
      "note": "Italy: the 0 is part of the number and is NOT dropped"
    },
    {
      "country": "SMR",
      "input": "0549 123456",
      "expected": "+3780549123456",
      "note": "San Marino follows Italy's rule"
    },
    {
      "country": "RUS",
      "input": "8 912 345 67 89",
      "expected": "+79123456789",
      "note": "Russia: trunk prefix 8 on 11 digits"
    },
    {
      "country": "KAZ",
      "input": "8 701 234 5678",
      "expected": "+77012345678",
      "note": "Kazakhstan shares dial code 7 with Russia"
    },
    {
      "country": "GBR",
      "input": "07911 123456",
      "expected": "+447911123456",
      "note": "United Kingdom: trunk prefix 0"
    },
    {
      "country": "DEU",
      "input": "0151 23456789",
      "expected": "+4915123456789",
      "note": "Germany: trunk prefix 0"
    },
    {
      "country": "+39",
      "input": "06 1234 5678",
      "expected": "+390612345678",
      "note": "Italy via dial code rather than alpha-3"
    },
    {
      "country": "IDN",
      "input": "08571860907️9",
      "expected": "+6285718609079",
      "note": "a digit joined to a variation selector is still a digit. Swift dropped it, because String.filter iterates grapheme clusters rather than scalars — one person, two record keys"
    },
    {
      "country": "IDN",
      "input": "0857​1860​9079",
      "expected": "+6285718609079",
      "note": "a zero-width space inside the number is ignored like any other space"
    },
    {
      "country": "  IDN  ",
      "input": "0857 1860 9079",
      "expected": "+6285718609079",
      "note": "ASCII spaces around the country code are still trimmed"
